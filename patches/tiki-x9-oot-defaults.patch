 # build used --gpu none, as the A20's architecture name was not known
 pso_gpu	applegpu_g19p
 # Frame rate: the host steps the game in whole vsyncs (patches.py FRAME_STEP: the frame-rate controller's interval and fps follow the host's step), so the launcher's Frame rate
-# setting offers 30 and 60. At 30 every frame is held two vsyncs (33.3 ms) and the game's own 30 fps mode steps its time by two, so it runs at full speed
-fps_target	60
+# setting offers 30 and 60. At 30 every frame is held two vsyncs (33.3 ms) and the game's own 30 fps mode steps its time by two, so it runs at full speed.
+# Default 30 (was 60): on an 8 GB iPhone / Mac the game cannot hold 60, and 30 is the rate the low-memory defaults below are tuned for. The player can still pick 60.
+fps_target	30
 # At 30 fps an iPhone lowers the GPU clock until the work fills most of the frame (iPhone 18 Pro at render scale 0.25: GPU p50 12 ms at 60 fps, 29-30 ms at 30, p95 33-38 ms;
 # log 60: 195 of 300 frames over 33.3 ms, p99 64 ms, 109 payback steps of 3 in 40 s). Three things make the 30 steady:
 # present snapshots, so the game's swapchain texture is free at once and its CPU work overlaps the GPU's instead of starting on the link's tick (log 60 had them off: frame
@@ -96,6 +97,10 @@ fps_payback	off
 # prewarm keeps no pipeline (warm-only, in the background); pools over 512 MB stay in the guest files, wired by the chunks the GPU reaches; render and depth targets of 4 MB and more
 # made only when a draw binds them (lazy textures). The Render scale stays the player's
 potato	DM_NVN_RES_EVICT_MB=4400,DM_NVN_TEX_RECYCLE_MB=64,DM_NVN_ALIAS_SWEEP=600,DM_PSO_WARM_ONLY=1,DM_PSO_PREPARE=0,DM_POOL_ANON_MAX_MB=512,DM_NVN_GMEM_NOBIG=1,DM_TEX_LAZY=2,DM_TEX_LAZY_MIN_KB=4096
+# Potato mode is on by default for this game (potato_default on; game.py DM_GAME_POTATO_DEFAULT, settings.tsv DM_PRESET): the player does not have to
+# turn it on in the launcher, and the rows it sets are locked at its values while it is on. Turning it off in the launcher is still one toggle, and a
+# saved choice still wins over this default. An env file that sets DM_PRESET keeps its own value.
+potato_default	on
 pad_layout	native
 # The touch controls' Forest colours: blue A, green B, yellow X / Y, red +, deep green shoulders, bronze D-pad, gold rims, all translucent (DmGamepad.m theme_init)
 pad_theme	forest
@@ -115,6 +120,7 @@ dispatch_overlap	on
 res_presets	off
 render_base	2560x1440 1920x1080
 render_scale	0.25:1.0:0.05
-render_scale_default	0.667
+# Default 0.25, marked Potato (was 0.667, the old Normal's 1280x720): the low-memory default for 8 GB devices. The player can still raise the slider.
+render_scale_default	0.25
 render_scale_marks	0.25=Potato
 frame_wg	off
