diff --git a/dm/host/live_controls.c b/dm/host/live_controls.c
new file mode 100644
index 0000000..f5013a2
--- /dev/null
+++ b/dm/host/live_controls.c
@@ -0,0 +1,48 @@
+// Live controls implementation. See live_controls.h for the port notes.
+// Self-contained: libc + pthread + stdatomic only, so the host test builds it
+// without the game profile. Logging is a local macro, not the host's MLOG/LOG.
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include "live_controls.h"
+#ifndef LIVE_LOG
+#define LIVE_LOG(...) do { flockfile(stderr); fprintf(stderr, "[dm] [live] " __VA_ARGS__); fputc('\n', stderr); funlockfile(stderr); } while (0)
+#endif
+// UI changes publish one atomic configuration; render and present threads never mutate the environment.
+static pthread_once_t g_live_once = PTHREAD_ONCE_INIT;
+static _Atomic unsigned g_live_flags, g_live_generation;
+static _Atomic int g_live_status;
+static _Atomic uint64_t g_live_gpu_us;
+static void live_init(void) {
+    const char *e = getenv("DM_LIVE_CONTROLS"); if (!e || atoi(e) != 1) return;
+    e = getenv("DM_LIVE_NATIVE_FPS"); unsigned flags = LIVE_ENABLED | LIVE_720 | LIVE_ADAPT | LIVE_ISOLATE;
+    if (e && atoi(e) == 30) flags |= LIVE_CAP30;
+    atomic_store(&g_live_flags, flags); atomic_store(&g_live_generation, 1);
+    LIVE_LOG("controls enabled; native target=%d, framegen off", flags & LIVE_CAP30 ? 30 : 60);
+}
+unsigned dm_live_flags(void) { pthread_once(&g_live_once, live_init); return atomic_load(&g_live_flags); }
+unsigned dm_live_generation(void) { dm_live_flags(); return atomic_load(&g_live_generation); }
+int dm_live_target(void) { unsigned s = dm_live_flags(); return s & LIVE_ENABLED ? (s & LIVE_CAP30 ? 30 : 60) : 0; }
+int dm_live_status(void) { return atomic_load(&g_live_status); }
+uint64_t dm_live_gpu_us(void) { return atomic_load(&g_live_gpu_us); }
+void dm_live_note(int status, uint64_t us) { atomic_store(&g_live_status, status); atomic_store(&g_live_gpu_us, us); }
+void dm_live_command(int command) {
+    unsigned before = dm_live_flags(), after; if (!(before & LIVE_ENABLED)) return;
+    if (command == LIVE_MARK) { LIVE_LOG("SAMPLE flags=%u target=%d generation=%u fg_status=%d fg_gpu=%.3f ms", before, dm_live_target(), dm_live_generation(), dm_live_status(), dm_live_gpu_us() / 1000.); return; }
+    do {
+        after = before;
+        switch (command) {
+            case LIVE_TOGGLE_FG: after ^= LIVE_FG; if (after & LIVE_FG) after |= LIVE_CAP30; break;
+            case LIVE_NATIVE60: after &= ~(LIVE_FG | LIVE_CAP30); break;
+            case LIVE_NATIVE30: after = (after & ~LIVE_FG) | LIVE_CAP30; break;
+            case LIVE_OUTPUT720: after |= LIVE_720; break;
+            case LIVE_OUTPUT1080: after &= ~LIVE_720; break;
+            case LIVE_TOGGLE_ADAPT: after ^= LIVE_ADAPT; break;
+            case LIVE_TOGGLE_ISOLATE: after ^= LIVE_ISOLATE; break;
+            default: return;
+        }
+    } while (!atomic_compare_exchange_weak(&g_live_flags, &before, after));
+    if (after != before) { unsigned n = atomic_fetch_add(&g_live_generation, 1) + 1; LIVE_LOG("CHANGE generation=%u command=%d framegen=%d native_target=%d output=%s adaptive=%d isolation=%d", n, command, !!(after & LIVE_FG), after & LIVE_CAP30 ? 30 : 60, after & LIVE_720 ? "720p" : "1080p", !!(after & LIVE_ADAPT), !!(after & LIVE_ISOLATE)); }
+}
