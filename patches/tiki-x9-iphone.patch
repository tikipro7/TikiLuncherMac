+// Live controls state machine, no host: the same 27 checks as the lab's
+// reference/tests/test_live_controls.c (24 + 3), with the iOS names/env vars.
+// No assertion is weakened: the 30/60 values, the toggles and the invalid
+// command 999 are the specified behaviour.
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include "../live_controls.h"
+static int checks, failed;
+#define CHECK(c) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL line %d\n", __LINE__); } } while (0)
+int main(int argc, char **argv) {
+    (void)argv;
+    if (argc > 1) { unsetenv("DM_LIVE_CONTROLS"); CHECK(dm_live_flags() == 0); dm_live_command(LIVE_TOGGLE_FG); CHECK(dm_live_flags() == 0); CHECK(dm_live_target() == 0); }
+    else {
+        setenv("DM_LIVE_CONTROLS", "1", 1); setenv("DM_LIVE_NATIVE_FPS", "60", 1);
+        CHECK(dm_live_flags() & LIVE_ENABLED); CHECK(!(dm_live_flags() & LIVE_FG)); CHECK(dm_live_target() == 60);
+        unsigned gen = dm_live_generation(); dm_live_command(LIVE_TOGGLE_FG); CHECK(dm_live_flags() & LIVE_FG); CHECK(dm_live_target() == 30); CHECK(dm_live_generation() > gen);
+        dm_live_command(LIVE_TOGGLE_FG); CHECK(!(dm_live_flags() & LIVE_FG)); CHECK(dm_live_target() == 30);
+        dm_live_command(LIVE_TOGGLE_FG); dm_live_command(LIVE_NATIVE60); CHECK(dm_live_target() == 60); CHECK(!(dm_live_flags() & LIVE_FG));
+        dm_live_command(LIVE_NATIVE30); CHECK(dm_live_target() == 30); CHECK(!(dm_live_flags() & LIVE_FG));
+        dm_live_command(LIVE_OUTPUT1080); CHECK(!(dm_live_flags() & LIVE_720)); dm_live_command(LIVE_OUTPUT720); CHECK(dm_live_flags() & LIVE_720);
+        unsigned state = dm_live_flags(); dm_live_command(LIVE_TOGGLE_ADAPT); CHECK((dm_live_flags() ^ state) == LIVE_ADAPT);
+        state = dm_live_flags(); dm_live_command(LIVE_TOGGLE_ISOLATE); CHECK((dm_live_flags() ^ state) == LIVE_ISOLATE);
+        state = dm_live_flags(); gen = dm_live_generation(); dm_live_command(999); CHECK(dm_live_flags() == state); CHECK(dm_live_generation() == gen);
+        dm_live_note(LIVE_FG_LATE, 1234); CHECK(dm_live_status() == LIVE_FG_LATE); CHECK(dm_live_gpu_us() == 1234);
+        dm_live_command(LIVE_MARK); CHECK(dm_live_flags() == state);
+    }
+    printf("live controls: %d checks, %d failed\n", checks, failed); return failed ? 1 : 0;
+}
