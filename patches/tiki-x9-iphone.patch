new file mode 100644
index 0000000..ce2a760
--- /dev/null
+++ b/dm/host/live_controls.h
@@ -0,0 +1,25 @@
+// Live controls: one atomic configuration for the in-game menu / launcher.
+// Ported from the Traspaso-iPhone lab package (reference/framegen/LiveControls.h +
+// live_controls.inc), adapted for kid X9 / iOS:
+//  - plain C module, no AppKit, no setenv from the UI thread, no host dependency:
+//    the UI publishes commands, the render/present threads only read atomics.
+//  - names renamed LAB_* -> LIVE_*, dm_lab_live_* -> dm_live_*, env DM_LAB_LIVE ->
+//    DM_LIVE_CONTROLS, DM_LAB_NATIVE_FPS -> DM_LIVE_NATIVE_FPS (same semantics).
+//  - the lab's lab_capture_on() (DM_FG_METALFX) is dropped: X9's frame generation is
+//    DM_FRAMEGEN, read once at launch by fg_on() (nvn_mtl.m); this module does not
+//    pretend to switch it live. See port-ios/PORT-IOS-REPORT.md, Fase C.
+//  - what it DOES do today: atomic state + generation counter + performance-sample
+//    logging (LIVE_MARK), consumable by the HUD / log. Wiring a live framegen toggle
+//    needs host work first (reset g_fg_mode + snapshot ring, see the report).
+#pragma once
+#include <stdint.h>
+enum { LIVE_FG = 1, LIVE_CAP30 = 2, LIVE_720 = 4, LIVE_ADAPT = 8, LIVE_ISOLATE = 16, LIVE_ENABLED = 256 };
+enum { LIVE_TOGGLE_FG = 1, LIVE_NATIVE60, LIVE_NATIVE30, LIVE_OUTPUT720, LIVE_OUTPUT1080, LIVE_TOGGLE_ADAPT, LIVE_TOGGLE_ISOLATE, LIVE_MARK };
+enum { LIVE_FG_OFF, LIVE_FG_WARMING, LIVE_FG_ACTIVE, LIVE_FG_LATE, LIVE_FG_DEPTH, LIVE_FG_ERROR };
+unsigned dm_live_flags(void);
+unsigned dm_live_generation(void);
+int dm_live_target(void);
+void dm_live_command(int command);
+void dm_live_note(int status, uint64_t gpu_us);
+int dm_live_status(void);
+uint64_t dm_live_gpu_us(void);
